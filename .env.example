# ──────────────────────────────────────────────────────
# Agentic ML Experimentation System — Environment
# ──────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# ── LLM Provider ──────────────────────────────────────
# "fallback" — deterministic demo mode, no API quota used (default)
# "gemini"   — uses the Gemini API for experiment planning
LLM_PROVIDER=fallback

# ── Gemini Configuration (required only when LLM_PROVIDER=gemini) ──
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-3.8-flash

# ── CORS Allowed Origins ─────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Set this in production to your Vercel frontend URL.
# When not set, localhost development defaults are used automatically.
#
# Examples:
#   CORS_ORIGINS=https://your-app.vercel.app
#   CORS_ORIGINS=https://your-app.vercel.app,https://staging.vercel.app
# CORS_ORIGINS=